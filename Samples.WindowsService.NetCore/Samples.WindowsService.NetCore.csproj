<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Samples.WindowsService.NetCore</RootNamespace>
    <AssemblyName>Samples.WindowsService.NetCore</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b7c9e1f3-4a5d-6e7f-8091-a2b3c4d5e6f7</UserSecretsId>
  </PropertyGroup>

  <!-- *Migration Note: this project was originally just "Samples.WindowsService", built
       directly on net10.0 with no net48 baseline first, which didn't match this solution's
       actual policy (net48 is the baseline, a Core sibling is only added to illustrate a
       genuine difference). Renamed to Samples.WindowsService.NetCore, and a genuinely
       separate, classic ServiceBase-based Samples.WindowsService (net48) now exists
       alongside it, giving this project a real baseline to be compared against, the same
       structure as every other classic+Core pair in this solution. See LectureNotes.md for
       the specific, real differences between the two: Generic Host + BackgroundService +
       UseWindowsService() here vs. classic ServiceBase's OnStart/OnStop here, EF Core
       Code-First vs. EF6 Database-First, LoggerMessage.Define vs. Serilog directly. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <!-- Microsoft.Extensions.Hosting already pulls this in transitively as a runtime
         assembly, so it's not strictly required for compilation, kept as a direct
         reference anyway for the LoggerMessage.Define calls in Worker.cs, since that's
         genuinely what those calls depend on. See LectureNotes.md for why Worker.cs uses
         LoggerMessage.Define rather than the newer [LoggerMessage] attribute pattern. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" />
    <None Include="LectureNotes.md" />
  </ItemGroup>

</Project>
