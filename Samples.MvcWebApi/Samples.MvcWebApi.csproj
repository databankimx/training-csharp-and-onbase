  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <!-- *Migration Note: classic ASP.NET (System.Web-based) projects have no official SDK-style
       support, so this stays a legacy-style Web Application project, matching every other web
       project in SampleProjects. packages.config is gone, every package is a <PackageReference>
       instead. Several changes beyond the standard modernization pattern, see LectureNotes.md:
         - Areas/HelpPage (the classic Web API doc UI) was DROPPED, genuinely redundant with
           Swashbuckle/Swagger, which is kept and is the more modern, actively maintained choice
         - log4net replaced with Serilog (DataBank's current standard)
         - ApplicationException replaced with DatabankException (CSharp.SharedLibrary)
         - Bootstrap bumped 3.4.1 -> 5.x, which REQUIRED real markup changes in the Views (BS5
           removed .jumbotron, renamed navbar-toggle/data-toggle to their bs5 equivalents), not
           just a version bump, see Views/Shared/_Layout.cshtml and Views/Home/Index.cshtml
         - Bootstrap/jQuery/Modernizr NuGet packages dropped entirely in favor of CDN references,
           those packages only ever worked by physically copying files into the project under the
           legacy packages.config installation model, which PackageReference does not replicate
         - Three hardcoded connection strings in Web.config genericized/cleaned up, two of the
           three were dead, pointing at EDMX resource names that don't exist in this project at all -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{8D4C296F-A1B2-4C3D-9E5F-6A7B8C9D0E1F}</ProjectGuid>
    <ProjectTypeGuids>{349c5851-65df-11da-9384-00065b846f21};{fae04ec0-301f-11d3-bf4b-00c04f79efbc}</ProjectTypeGuids>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>Samples.MvcWebApi</RootNamespace>
    <AssemblyName>Samples.MvcWebApi</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <MvcBuildViews>false</MvcBuildViews>
    <!-- *Migration Note: AutoGenerateBindingRedirects is ALSO set solution-wide in
         Directory.Build.props, but this project hit a build warning explicitly asking for it
         to be set anyway, evidently that inheritance doesn't reliably reach every legacy web
         project, so it's set explicitly here too rather than relying on it. See
         LectureNotes.md. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <UseIISExpress>true</UseIISExpress>
