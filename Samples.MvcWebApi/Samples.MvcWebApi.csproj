         above for why Areas/HelpPage was dropped. -->
    <PackageReference Include="Swashbuckle" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeDom.Providers.DotNetCompilerPlatform" Version="4.1.0" />
    <!-- Serilog (DataBank's current logging standard, replacing log4net), matching the pattern
         already established in Samples.AsmxWebService/Samples.WcfService. -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <!-- *Migration Note: the original packages.config explicitly pinned BOTH of these (Antlr
         3.5.0.2, WebGrease 1.6.0), specifically to avoid exactly the version conflict hit here:
         Microsoft.AspNet.Mvc/WebPages pull in an OLDER Antlr (3.4.1.9004, transitively, via
         Razor) and an older WebGrease (1.5.2), while Microsoft.AspNet.Web.Optimization wants
         newer versions of both. Omitting these (assuming PackageReference would resolve the
         conflict automatically) was wrong, two different things in the graph genuinely want
         different versions, and NuGet won't silently pick one without an explicit pin telling
         it which to prefer. Added back, matching the original's own values. See
         LectureNotes.md. -->
    <PackageReference Include="Antlr" Version="3.5.0.2" />
    <PackageReference Include="WebGrease" Version="1.6.0" />
  </ItemGroup>
