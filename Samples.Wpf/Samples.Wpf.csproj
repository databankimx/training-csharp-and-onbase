<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Samples.Wpf</RootNamespace>
    <AssemblyName>Samples.Wpf</AssemblyName>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- *Migration Note: originally built directly on net10.0-windows, on the reasoning that
       "this is the current correct way to build a new WPF app." That doesn't match this
       solution's actual policy, net48 is the baseline for every Samples.* project, a
       net10.0/Core sibling is only added when there's a genuinely illustrative difference
       worth showing side by side (the way Samples.MvcWebApi/.Core demonstrate real,
       documented contrasts). Corrected here: net48, EF6 Database-First (matching every other
       net48 sample's own EDMX), and DatabankException (CSharp.SharedLibrary is a valid
       reference again on net48, unlike the net10.0 samples). If a genuine, illustrative
       difference between classic and modern WPF ever emerges, a Samples.Wpf.Core sibling can
       be added at that point, not by default. See LectureNotes.md. -->

  <ItemGroup>
    <!-- EF6 (EDMX Database-First), same pattern and same underlying ZipCodes table as
         Samples.MvcWebPortal/Samples.WebForms. -->
    <PackageReference Include="EntityFramework" Version="6.5.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- DatabankException (replacing plain Exception, since CSharp.SharedLibrary is a valid
         reference on net48). -->
    <ProjectReference Include="..\CSharp.SharedLibrary\CSharp.SharedLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" />
    <None Include="LectureNotes.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDK-style auto-globbing only picks up .cs files, these EDMX/T4 items need explicit
         entries so Visual Studio's design-time tooling recognizes them (matching the
         legacy-style csproj entries every other net48 EDMX project in this solution has). -->
    <Compile Update="Models\LocationLookupModel.Context.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>LocationLookupModel.Context.tt</DependentUpon>
    </Compile>
    <Compile Update="Models\LocationLookupModel.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>LocationLookupModel.tt</DependentUpon>
    </Compile>
    <Compile Update="Models\LocationLookupModel.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>LocationLookupModel.edmx</DependentUpon>
    </Compile>
    <Compile Update="Models\ZipCode.cs">
      <DependentUpon>LocationLookupModel.tt</DependentUpon>
    </Compile>
    <None Include="Models\LocationLookupModel.Context.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <DependentUpon>LocationLookupModel.edmx</DependentUpon>
      <LastGenOutput>LocationLookupModel.Context.cs</LastGenOutput>
    </None>
    <None Include="Models\LocationLookupModel.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <DependentUpon>LocationLookupModel.edmx</DependentUpon>
      <LastGenOutput>LocationLookupModel.cs</LastGenOutput>
    </None>
    <EntityDeploy Include="Models\LocationLookupModel.edmx">
      <Generator>EntityModelCodeGenerator</Generator>
      <LastGenOutput>LocationLookupModel.Designer.cs</LastGenOutput>
    </EntityDeploy>
    <None Include="Models\LocationLookupModel.edmx.diagram">
      <DependentUpon>LocationLookupModel.edmx</DependentUpon>
    </None>
  </ItemGroup>

</Project>
