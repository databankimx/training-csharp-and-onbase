<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <!-- EntityFramework's own AssemblyVersion has stayed frozen at 6.0.0.0 across every
         6.x NuGet package release (6.4.4, 6.5.2, etc. are PACKAGE version numbers, not
         assembly version numbers), so "Version=6.0.0.0" here is correct regardless of
         which 6.x package is actually installed, don't "fix" it to match the package
         version, that's the mistake that caused this to break in the first place. -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <!--
    *Migration Note:
    The original download's Web.config was essentially empty, only XDT-transform-syntax
    comments, no actual connectionStrings section, no entityFramework section. Since
    NorthwindsEntities.cs calls base("name=Northwinds"), that connection string entry
    genuinely has to exist for this service to work at all, this section was added
    during the 2026 migration to make the service actually runnable. Update Data Source
    below to match your SQL Server instance, see CSharp.Ch09.TextbookCode.NorthwindsConsole's
    README.md for setup instructions (same "Northwinds" database, shared by both projects).
  -->
  <connectionStrings>
    <add name="Northwinds" connectionString="Data Source=.;Initial Catalog=Northwinds;Integrated Security=True;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!--
        *Migration Note:
        newVersion is 6.0.0.0, NOT the NuGet package version (6.4.4/6.5.2/etc.).
        EntityFramework's AssemblyVersion has stayed frozen at 6.0.0.0 across every 6.x
        package release, by design, for binary compatibility, only the package/file
        version actually changes between releases. Redirecting to anything other than
        6.0.0.0 here causes "Could not load file or assembly 'EntityFramework'...
        manifest definition does not match the assembly reference" the moment IIS tries
        to load the physically-present DLL, whose real assembly identity is always
        6.0.0.0 regardless of which package version is actually installed.
      -->
      <dependentAssembly>
        <assemblyIdentity name="EntityFramework" publicKeyToken="b77a5c561934e089" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>

      <!--
        *Migration Note:
        Unlike EntityFramework, these WCF Data Services packages' assembly versions DO
        track their package version directly (installing package 5.8.4 gives assembly
        version 5.8.4.0, not a frozen constant). These redirects exist so that updating
        these NuGet packages in the future doesn't ALSO require manually hunting down and
        editing every hardcoded version string that names one of these assemblies (e.g.
        NorthwindsService.svc's Factory attribute), that's exactly the mistake that broke
        this service the first two times it was actually run: a hardcoded version string
        left stale after a package update. newVersion below must still be kept in sync
        with whatever's actually installed (see packages.config), but with this redirect
        in place, other places that reference these assemblies by a slightly-stale
        version resolve correctly anyway rather than failing outright.
      -->
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Data.Services" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.8.4.0" newVersion="5.8.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Data.Services.Client" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.8.4.0" newVersion="5.8.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Data.OData" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.8.4.0" newVersion="5.8.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Data.Edm" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.8.4.0" newVersion="5.8.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Spatial" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.8.4.0" newVersion="5.8.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>