<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <section name="restApiSettings" type="RestApi._00.CommonFunctionality.Models.Configuration.RestApiSettings, RestApi.00.CommonFunctionality" />
    </configSections>
    <!-- *Migration Note: no <startup>/<supportedRuntime> element here, unlike
         Unity.TestHarness's own App.config: that element is specifically how a net48 app
         declares which .NET Framework version it targets, this project's target
         framework (net10.0-windows) is declared directly in its .csproj instead, modern
         SDK-style projects don't use App.config for this at all. -->
    <!-- SidebarExpanded remembers the collapse/expand toggle's state across runs, written
         back here automatically whenever it's toggled (via HarnessSettings.cs), not
         something you need to edit by hand. -->
    <appSettings>
        <add key="SidebarExpanded" value="true" />
    </appSettings>
    <!-- *Migration Note: starting values are placeholders, edit them here directly, or
         (more conveniently) launch the harness and use its Settings page, which can write
         updated values back to this exact section via its "Save to App.config" button.
         No <docPop> element (no REST API equivalent exists) and apiServerUrl/formsApiUrl
         replace servicePath (two separate REST APIs, same server, different base paths,
         see RestApi.00.CommonFunctionality's own ServiceLocation for why). See
         LectureNotes.md. -->
    <restApiSettings>
        <serviceLocation apiServerUrl="https://OnBaseSandboxVM/apiserver/onbase/core"
                          formsApiUrl="https://OnBaseSandboxVM/apiserver/onbase/forms"
                          authenticationMode="OnBaseCredentials" username="MANAGER" password="password" />
        <idpSettings idpUrl="" idpTenant="" idpClientId="" idpClientSecret="" idpScope="evolution" idpGrantType="password" />
    </restApiSettings>
</configuration>
