<UserControl x:Class="RestApi.TestHarness.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:RestApi.TestHarness.Behaviors"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="900">

    <!-- *Migration Note: no Session ID/Allow Session Failover fields, no License Type, no
         DocPop section at all, unlike Unity.TestHarness's own SettingsView, all confirmed
         gaps, see SettingsViewModel's own Training Notes. ApiServerUrl/FormsApiUrl replace
         Application ID/Service Path/Data Source. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="Edits apply in-memory for this run only, unless you Save to App.config."
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,-8,0,20" TextWrapping="Wrap" />

            <!-- Connection -->
            <TextBlock Text="Connection" FontWeight="SemiBold" Margin="0,0,0,8" />

            <TextBlock Text="API Server URL" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding ApiServerUrl, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Forms API URL" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding FormsApiUrl, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox Content="Keep Alive (send a periodic heartbeat to keep the session from expiring during idle periods)" IsChecked="{Binding KeepAlive}" Margin="0,0,0,20" />

            <!-- Authentication -->
            <TextBlock Text="Authentication" FontWeight="SemiBold" Margin="0,0,0,8" />

            <TextBlock Text="Authentication Mode" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding AuthenticationModes}" SelectedItem="{Binding AuthenticationMode}" />

            <!-- OnBaseCredentials: the only currently-implemented mode -->
            <StackPanel Visibility="{Binding IsOnBaseCredentialsMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" />
                <PasswordBox behaviors:PasswordBoxBehavior.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- DomainCredentials: stubbed -->
            <TextBlock Text="Stubbed: no documented Hyland IdP grant type equivalent to NT/Windows-integrated authentication was found for this training set."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding IsDomainCredentialsMode, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- AccessToken: stubbed -->
            <StackPanel Visibility="{Binding IsAccessTokenMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Stubbed: not yet implemented in this training set, even though a user-supplied token would need no grant flow at all." 
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Access Token" Style="{StaticResource FieldLabelStyle}" />
                <PasswordBox behaviors:PasswordBoxBehavior.BoundPassword="{Binding AccessToken, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- SingleSignOn: stubbed -->
            <StackPanel Visibility="{Binding IsSingleSignOnMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Stubbed: maps conceptually to Authorization Code with PKCE, which requires a browser-based redirect flow not yet built."
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="License Token" Style="{StaticResource FieldLabelStyle}" />
                <PasswordBox behaviors:PasswordBoxBehavior.BoundPassword="{Binding LicenseToken, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Hyland IdP settings: always shown, needed by OnBaseCredentials (the "password" grant) -->
            <TextBlock Text="Hyland IdP Settings" FontWeight="SemiBold" Margin="0,12,0,8" />
            <TextBlock Text="IdP URL" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding IdpUrl, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="IdP Tenant" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding IdpTenant, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="IdP Client ID" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding IdpClientId, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="IdP Client Secret" Style="{StaticResource FieldLabelStyle}" />
            <PasswordBox behaviors:PasswordBoxBehavior.BoundPassword="{Binding IdpClientSecret, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="IdP Scope" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding IdpScope, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="IdP Grant Type (only &quot;password&quot; is currently implemented)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding IdpGrantType, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,32">
                <Button Content="Apply" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Save to App.config" Command="{Binding SaveToConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Reload" Command="{Binding ReloadCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
