<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="onBaseSettings" type="Unity._00.CommonFunctionality.Models.Configuration.OnBaseSettings, Unity.00.CommonFunctionality" />
  </configSections>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- *Migration Note: InProc session state holds the live Hyland.Unity Application
         object directly, mirroring the one long-lived connection Unity.TestHarness (the
         WPF version) keeps open for its whole process lifetime. This is a genuine
         constraint, not just a default: InProc is the only built-in session mode that can
         hold a non-serializable object reference at all; StateServer/SQLServer modes
         require session content to serialize, which the Unity API's own connection
         objects were never designed to do. See LectureNotes.md for the tradeoffs (no
         survival across an app pool recycle, and this ties the app to a single server
         without additional work) and the documented alternative (reconnect by Session ID
         per request, using the SessionManagement capability the API itself provides).
         Timeout matches KeepAlive's own default assumption of an actively-used session. -->
    <sessionState mode="InProc" timeout="60" />
  </system.web>
  <!-- *Migration Note: mirrors Unity.TestHarness (the WPF version)'s own App.config
       exactly, same section type, same structure (SessionManagement reads this via
       ConfigurationManager regardless of which host app it's running in). Starting values
       are placeholders, same as the WPF version's own App.config, edit them here
       directly, or use the Settings page's "Save to Web.config" action once that page
       exists. -->
  <onBaseSettings>
    <serviceLocation applicationId="" servicePath="http://OnBaseSandboxVM/AppServer/Service.asmx"
                      dataSource="OnBaseSandbox" licenseType="Default"
                      authenticationMode="OnBaseCredentials" username="MANAGER" password="password" />
    <docPop docPopBaseUrl="http://OnBaseSandboxVM/AppNet/DocPop/DocPop.aspx" docPopChecksumSeed="" />
    <idpSettings idpUrl="" idpTenant="" idpClientId="" idpClientSecret="" idpScope="evolution" idpGrantType="password" />
  </onBaseSettings>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" culture="neutral" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Optimization" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-1.1.0.0" newVersion="1.1.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-5.3.0.0" newVersion="5.3.0.0" />
      </dependentAssembly>
      <!-- *Migration Note: added after a runtime FileLoadException from an earlier
           Serilog.Settings.Configuration-based setup (since removed, see the
           PackageReference note in the .csproj), Serilog's own package reference was
           still observed drifting slightly across restores, so this redirect is kept as
           a harmless safety net; newVersion should be kept in sync with whatever
           Serilog's PackageReference Version is set to above. -->
      <dependentAssembly>
        <assemblyIdentity name="Serilog" publicKeyToken="24c2f752a8e58a10" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.4.0.0" newVersion="4.4.0.0" />
      </dependentAssembly>
      <!-- *Migration Note: same pattern as the Serilog redirect above, a "polyfill"
           assembly (used to bridge .NET Standard-targeted libraries onto .NET Framework,
           likely pulled in transitively by Hyland.Unity and/or Newtonsoft.Json) hitting a
           stale/missing binding policy under this legacy Web Application project.
           newVersion confirmed directly via AssemblyName.GetAssemblyName against the
           actual bin/System.Memory.dll (4.0.5.0), the initial 4.0.1.2 guess based on the
           runtime error's own reported "requested" version was wrong, that's the version
           being ASKED FOR, not what's actually on disk. -->
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
