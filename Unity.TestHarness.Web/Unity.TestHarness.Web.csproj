    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Abstractions" />
    <Reference Include="System.Web.Routing" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Configuration" />
    <!-- HttpClient (server ping check in SessionConnectionManager.TestServer). Strong
         name pinned explicitly (matching the exact identity .NET 4.8's own type-forwarding
         error names) rather than a bare Include="System.Net.Http", which resolved
         ambiguously here, likely because a NuGet package elsewhere in the dependency
         graph also touches this assembly (see the binding-redirect-conflict warning). -->
    <Reference Include="System.Net.Http, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a">
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hyland.Unity" Version="26.1.2" />
    <!-- *Migration Note: Serilog.Settings.Configuration and the Microsoft.Extensions.Configuration
         packages were tried first (matching Unity.TestHarness's own approach) but pulled
         in a deep transitive dependency chain that triggered a cascading series of
         binding-redirect FileLoadExceptions specific to this being a legacy Web
         Application project. Global.asax.cs now reads serilog.json directly with
         Newtonsoft.Json instead (already a dependency here, far shallower footprint),
         settings stay externally configurable, nothing is hardcoded, only the LOADING
         mechanism changed. See LectureNotes.md. -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
    <PackageReference Include="Microsoft.AspNet.WebPages" Version="3.3.0" />
    <PackageReference Include="Microsoft.AspNet.Web.Optimization" Version="1.1.3" />
    <PackageReference Include="Microsoft.CodeDom.Providers.DotNetCompilerPlatform" Version="4.1.0" />
    <!-- *Migration Note: pinned explicitly, matching Samples.MvcWebPortal's own fix, see
         its LectureNotes.md for why (Mvc/WebPages/Razor transitively want an OLDER
         Antlr/WebGrease than Web.Optimization wants; omitting the pin lets NuGet's
         automatic resolution pick inconsistent versions across the dependency graph). -->
    <PackageReference Include="Antlr" Version="3.5.0.2" />
    <PackageReference Include="WebGrease" Version="1.6.0" />
  </ItemGroup>
