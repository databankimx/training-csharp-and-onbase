<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <!-- *Migration Note: point BaseUrl at your own shared Unity Form URL, and set Token to
         either the plain value (fine for local testing) or, for anything resembling a
         real deployment, "registry:HKLM\...,Token" per RegistryExtensions.IsEncrypted(),
         populated via aspnet_setreg.exe, the same DPAPI-encrypted-registry-value pattern
         Unity.00.CommonFunctionality's ServiceLocation/IdpSettings use for their own
         secrets. See LectureNotes.md. -->
    <appSettings>
        <add key="BaseUrl" value="http://OnBaseSandboxVM/AppNet/UnityForm.aspx?d1=YourShareTokenHere" />
        <add key="Token" value="YourBase64EncodedTokenHere" />
    </appSettings>
</configuration>
