{
  "RestApi": {
    "ApiServerUrl": "https://OnBaseSandboxVM/apiserver/onbase/core",
    "FormsApiUrl": "https://OnBaseSandboxVM/apiserver/onbase/forms",
    "KeepAlive": true,
    "IdpUrl": "",
    "IdpTenant": "",
    "IdpClientId": "",
    "IdpClientSecret": "",
    "IdpScope": "evolution",
    "IdpGrantType": "password"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/debug-log-.txt",
          "restrictedToMinimumLevel": "Verbose",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}{NewLine}",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10000000,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 5
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/error-log-.txt",
          "restrictedToMinimumLevel": "Error",
          "outputTemplate": "-----{NewLine}[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}-----{NewLine}",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10000000,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 5
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
