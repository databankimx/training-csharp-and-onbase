<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Samples.WinForms</RootNamespace>
    <AssemblyName>Samples.WinForms</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- *Migration Note: no legacy source to port here, this is a fresh addition to
       SampleProjects, targeting net10.0-windows directly, the current correct way to build a
       new WinForms application, same reasoning as Samples.Wpf. Unlike that project, this one
       deliberately does NOT use MVVM, WinForms' idiomatic pattern is direct, imperative event
       handlers manipulating controls, not declarative data binding, and that contrast is the
       whole point of building both. See LectureNotes.md. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="README.md" />
    <None Include="LectureNotes.md" />
  </ItemGroup>

</Project>
