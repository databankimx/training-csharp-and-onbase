<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- Section required for functionality of managed Oracle DataAccess Components (ODAC) -->
    <section name="oracle.manageddataaccess.client" type="OracleInternal.Common.ODPMSectionHandler, Oracle.ManagedDataAccess, Version=4.122.23.1, Culture=neutral, PublicKeyToken=89b483f429c47342" />
    <!-- Custom configuration sections must be defined before they are added  -->
    <section name="serviceSettings" type="Samples.WcfService.Models.Configuration.ServiceSettings, Samples.WcfService" />
  </configSections>
  <appSettings>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
  </appSettings>
  <!-- Web Service Settings:
       - debugMode: When true, the application will perform trace logging. Otherwise, error logging only.
  -->
  <serviceSettings debugMode="true">
    <!-- Database Settings:
           - Global Required Settings:
             - architecture:        Identifies the database architecture (SqlServer | Oracle | MySql | Odbc)
             - ntAuthentication:    When true, use NT authentication. Otherwise, use username/password.
             - username:            Database login user name
             - password:            Database login password
         
         * Note: You should add only the settings appropriate to your selected architecture
         
         - SQL Server Settings:
             - Required:
               - server:            Database server hostname or IP
               - database:          Database name
             - Optional
               - port:              Port number
               - sqlInstance:       Instance name (if non-default)
               
         - Oracle Settings:
             - Required
               - oracleTnsName:     Oracle TNS data source name
             - Optional
               - port:              Port number
               
         - ODBC Settings:
             - Required
               - odbcDataSource:    ODBC data source name (DSN)
             - Optional
               - port:              Port number
               
         - MySQL Settings:
             - Required:
               - server:            Database server hostname or IP
               - database:          Database name
             - Optional
               - port:              Port number

         *Migration Note: the original sample values here pointed at a real internal test server
         and a real (if low-value) credential pair. Genericized below, point these at your own
         SQL Server instance to actually run this sample. See LectureNotes.md.
    -->
    <database architecture="SqlServer" server="YourSqlServerHostname" database="ExternalData" ntAuthentication="false" username="YourUsername" password="YourPassword" />
  </serviceSettings>
  <!-- *Migration Note: Serilog (DataBank's current logging standard, replacing log4net) is
       configured directly in code (see ExampleWebService.svc.cs's static constructor) plus
       serilog.json, not through an XML config section the way log4net required, so no
       <log4net> block or config section is needed here anymore. See LectureNotes.md. -->
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.serviceModel>
    <!-- Bindings define how the client application communicates with the service -->
    <bindings>
      <!-- This binding is set up to allow AJAX calls from our HTML/JavaScript client -->
      <webHttpBinding>
        <binding name="webBinding" maxBufferSize="2147483647" maxReceivedMessageSize="2147483647" sendTimeout="00:05:00">
          <readerQuotas maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxDepth="2147483647" maxStringContentLength="2147483647" maxNameTableCharCount="2147483647" />
          <!-- If using SSL, un-comment the section below -->
          <!--
          <security mode="Transport">
            <transport clientCredentialType="None" proxyCredentialType="None"/>
          </security>
          -->
        </binding>
      </webHttpBinding>
      <!-- This binding is set up to allow direct calls from our .NET clients (by service reference or proxy class) -->
      <basicHttpBinding>
        <binding name="appBinding" maxBufferSize="2147483647" maxReceivedMessageSize="2147483647" sendTimeout="00:05:00">
          <readerQuotas maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxDepth="2147483647" maxStringContentLength="2147483647" maxNameTableCharCount="2147483647" />
          <!-- If using SSL, un-comment the section below -->
          <!--
          <security mode="Transport">
            <transport clientCredentialType="None" proxyCredentialType="None"/>
          </security>
          -->
        </binding>
      </basicHttpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="defaultServiceBehavior">
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
      <!-- Endpoint behaviors are used by the endpoints to couple to bindings -->
      <endpointBehaviors>
        <!-- We're adding this behavior to support AJAX calls from our HTML/JavaScript client -->
        <behavior name="webEndpointBehavior">
          <webHttp />
        </behavior>
      </endpointBehaviors>
    </behaviors>
    <!-- Adding the optional "services" section allows us to explicitly define multiple endpoints -->
    <!-- NOTE: When configuring multiple endpoints, you must specify different addresses for each one -->
    <services>
      <!-- The service is the actual .NET service to which we will connect -->
      <service name="Samples.WcfService.ExampleWebService" behaviorConfiguration="defaultServiceBehavior">
        <!-- This endpoint (using the Basic HTTP protocol) will be used by our .NET clients -->
        <!-- NOTE: Because the "address" is empty, the URL accessed will be our service without additional adornment -->
        <endpoint name="appEndpoint" address="" binding="basicHttpBinding" bindingConfiguration="appBinding" contract="Samples.WcfService.IExampleWebService" />
        <!-- This endpont (using the Web HTTP protocol) will be used by our HTML/JavaScript client -->
        <!-- NOTE: The address is relative and represents only what is appended (in the REST model) to the service URL -->
        <endpoint name="webEndpoint" address="Web" binding="webHttpBinding" bindingConfiguration="webBinding" contract="Samples.WcfService.IExampleWebService" behaviorConfiguration="webEndpointBehavior" />
      </service>
    </services>
    <protocolMapping>
      <add binding="basicHttpsBinding" scheme="https" />
    </protocolMapping>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
  </system.serviceModel>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <!--
        To browse web app root directory during debugging, set the value below to true.
        Set to false before deployment to avoid disclosing web app folder information.
      -->
    <directoryBrowse enabled="true" />
  </system.webServer>
  <system.data>
    <DbProviderFactories>
      <remove invariant="Oracle.ManagedDataAccess.Client" />
      <add name="ODP.NET, Managed Driver" invariant="Oracle.ManagedDataAccess.Client" description="Oracle Data Provider for .NET, Managed Driver" type="Oracle.ManagedDataAccess.Client.OracleClientFactory, Oracle.ManagedDataAccess, Version=4.122.23.1, Culture=neutral, PublicKeyToken=89b483f429c47342" />
    </DbProviderFactories>
  </system.data>
  <!-- *Migration Note: for a WEB APPLICATION project, MSBuild's binding-redirect generation
       writes its computed redirects into a companion "Samples.WcfService.dll.config" file in
       \bin, NOT into this Web.config, and ASP.NET only ever reads Web.config. This project's
       package list and versions are IDENTICAL to Samples.AsmxWebService's, so the redirects
       already validated there are reused directly here rather than re-discovering them the
       hard way, worth double-checking against the generated .dll.config after the first build
       regardless, in case dependency resolution differs even slightly. See LectureNotes.md.
  -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Serilog" publicKeyToken="24c2f752a8e58a10" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.4.0.0" newVersion="4.4.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.1" newVersion="8.0.0.1" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.6.0" newVersion="4.1.6.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.11" newVersion="10.0.0.11" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Configuration" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.11" newVersion="10.0.0.11" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Configuration.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.11" newVersion="10.0.0.11" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Primitives" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.11" newVersion="10.0.0.11" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.IO.Pipelines" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.11" newVersion="10.0.0.11" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Encodings.Web" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.11" newVersion="10.0.0.11" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.11" newVersion="10.0.0.11" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701;612;618" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008,40000,40008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=4.1.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
    </compilers>
  </system.codedom>
</configuration>
