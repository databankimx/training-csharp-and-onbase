<Project>

  <!-- ******************************************************************** -->
  <!--                   Copyright (C) 2026, DataBank IMX                   -->
  <!--                                                                      -->
  <!-- Shared build settings for every project in the developer training    -->
  <!-- solution. Individual .csproj files should stay as small as possible; -->
  <!-- anything common belongs here instead of being repeated per project.  -->
  <!-- ******************************************************************** -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>

  <PropertyGroup>
    <Company>DataBank IMX (a KYOCERA Group Company)</Company>
    <Product>DataBank IMX Developer Training</Product>
    <Copyright>Copyright © 2013-2026 DataBank IMX</Copyright>
		<AssemblyVersion>2.0.1</AssemblyVersion>
		<FileVersion>2.0.1</FileVersion>
  </PropertyGroup>

  <!-- Suppress specific warnings in TextbookCode projects. These are adapted    -->
  <!-- from textbook downloads and intentionally preserve their original style.   -->
  <!-- CS0168: variable declared but never used                                  -->
  <!-- CS0414: field assigned but value never used                               -->
  <!-- CS0649: field never assigned (always default value)                       -->
  <PropertyGroup Condition="$(MSBuildProjectName.Contains('TextbookCode'))">
    <NoWarn>$(NoWarn);CS0168;CS0414;CS0649</NoWarn>
  </PropertyGroup>

</Project>
