<UserControl x:Class="Unity.TestHarness.Views.ArchivingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Unity.TestHarness.ViewModels"
             xmlns:models="clr-namespace:Unity.TestHarness.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="1000">

    <UserControl.Resources>
        <!-- *Migration Note: shared by Store New (NewEditors) and Modify Metadata
             (ExistingEditors), same underlying KeywordEditorSet either way, only the
             ViewModel property bound to it differs. RelativeSource AncestorType=ItemsControl
             (default AncestorLevel=1) is how the "Remove Instance"/"Remove Value" buttons,
             nested two ItemTemplates deep, reach back up to the enclosing
             KeywordGroupEditor/StandaloneKeywordEditor's own command: an ItemsControl's
             OWN DataContext (as opposed to each rendered item's DataContext, set by its
             ItemTemplate) is whatever it inherited from its parent, unchanged, so the
             nearest ItemsControl ancestor's DataContext IS the editor itself. -->
        <DataTemplate DataType="{x:Type vm:KeywordEditorSet}">
            <StackPanel>
                <!-- Keyword Groups -->
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Content="+ Add Instance" Command="{Binding AddInstanceCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" HorizontalAlignment="Right"
                                                Visibility="{Binding IsMultiInstance, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Instances}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Fields}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabelStyle}" />
                                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button Content="Remove Instance" HorizontalAlignment="Left" Padding="10,4" FontSize="11"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.RemoveInstanceCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Standalone Keywords -->
                <ItemsControl ItemsSource="{Binding Standalone}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Content="+ Add Value" Command="{Binding AddValueCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Values}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,6">
                                                    <Button DockPanel.Dock="Right" Content="Remove" Margin="8,0,0,0" Padding="8,4" FontSize="11"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.RemoveValueCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- A file list with a Remove button per row, shared by all three "attach a file" panels -->
        <Style x:Key="FileListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left" Margin="0,0,0,32">
            <TextBlock Text="Archiving" Style="{StaticResource SectionHeaderStyle}" />

            <!-- Mode selector -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <RadioButton Content="Store New" GroupName="ArchivingMode" Margin="0,0,16,0"
                             IsChecked="{Binding IsStoreNewMode, Mode=OneWay}"
                             Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:ArchivingMode.StoreNew}" />
                <RadioButton Content="Modify Metadata" GroupName="ArchivingMode" Margin="0,0,16,0"
                             IsChecked="{Binding IsModifyMetadataMode, Mode=OneWay}"
                             Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:ArchivingMode.ModifyMetadata}" />
                <RadioButton Content="Add Revision" GroupName="ArchivingMode" Margin="0,0,16,0"
                             IsChecked="{Binding IsAddRevisionMode, Mode=OneWay}"
                             Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:ArchivingMode.AddRevision}" />
                <RadioButton Content="Add Rendition" GroupName="ArchivingMode" Margin="0,0,16,0"
                             IsChecked="{Binding IsAddRenditionMode, Mode=OneWay}"
                             Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:ArchivingMode.AddRendition}" />
                <RadioButton Content="Delete" GroupName="ArchivingMode"
                             IsChecked="{Binding IsDeleteMode, Mode=OneWay}"
                             Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:ArchivingMode.Delete}" />
            </StackPanel>

            <!-- Store New -->
            <StackPanel Visibility="{Binding IsStoreNewMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Document Type" Style="{StaticResource FieldLabelStyle}" DockPanel.Dock="Top" />
                    <Button DockPanel.Dock="Right" Content="Load Taxonomy" Command="{Binding LoadTaxonomyCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top" />
                </DockPanel>

                <TextBlock Text="Filter by Group (optional)" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding DocumentTypeGroupFilters}" SelectedItem="{Binding SelectedGroupFilter}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Same fix as Retrieval's group filter: the first entry is a
                                 null item representing "no filter", TargetNullValue can't
                                 catch this (it only substitutes for a null PROPERTY VALUE,
                                 not a null DataContext itself), so this binds to the item
                                 directly and lets the converter handle null explicitly. -->
                            <TextBlock Text="{Binding Converter={StaticResource DocumentTypeGroupFilterConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Document Type" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding AllDocumentTypesView}" SelectedItem="{Binding SelectedDocumentType}" DisplayMemberPath="Name" />

                <TextBlock Text="Document Date" Style="{StaticResource FieldLabelStyle}" />
                <DatePicker SelectedDate="{Binding NewDocumentDate}" />

                <TextBlock Text="File(s)" FontWeight="SemiBold" Margin="0,8,0,8" />
                <Border x:Name="NewFilesDropZone" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="20" Margin="0,0,0,8" AllowDrop="True">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Drag and drop file(s) here" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        <Button Content="Or Browse..." Command="{Binding AddNewFilesCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding NewFiles}" Style="{StaticResource FileListStyle}" MaxHeight="120">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Remove"
                                        Command="{Binding DataContext.RemoveNewFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" FontSize="11" />
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Keywords" FontWeight="SemiBold" Margin="0,8,0,8" />
                <ContentControl Content="{Binding NewEditors}" />

                <Button Content="Store New Document" Command="{Binding StoreNewCommand}" Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left" Margin="0,12,0,0" />
            </StackPanel>

            <!-- Shared "load an existing document" section, for Modify Metadata / Add Revision / Add Rendition -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStoreNewMode}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Document ID" Style="{StaticResource FieldLabelStyle}" />
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Load" Command="{Binding LoadDocumentCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding DocumentIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                </DockPanel>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="12" Margin="0,0,0,20"
                        Visibility="{Binding HasLoadedDocument, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding LoadedDocument.ID, StringFormat='Loaded: Document {0}'}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LoadedDocument.DocumentType.Name}" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding IsRevisable, StringFormat='Revisable: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding IsRenditionable, StringFormat='Renditionable: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Modify Metadata -->
                <StackPanel Visibility="{Binding IsModifyMetadataMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Visibility="{Binding HasLoadedDocument, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Document Type" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding ExistingDocumentTypeName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Document Date" Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding ExistingDocumentDate}" />

                        <TextBlock Text="Keywords" FontWeight="SemiBold" Margin="0,8,0,8" />
                        <ContentControl Content="{Binding ExistingEditors}" />

                        <Button Content="Save Metadata" Command="{Binding ModifyMetadataCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Add Revision -->
                <StackPanel Visibility="{Binding IsAddRevisionMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Visibility="{Binding HasLoadedDocument, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="This document type does not allow revisions." Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRevisable}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel IsEnabled="{Binding IsRevisable}">
                            <TextBlock Text="New Revision File(s)" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="4" Padding="20" Margin="0,0,0,8" AllowDrop="True" x:Name="RevisionFilesDropZone">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Drag and drop file(s) here" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <Button Content="Or Browse..." Command="{Binding AddRevisionFilesCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,8,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ListBox ItemsSource="{Binding RevisionFiles}" Style="{StaticResource FileListStyle}" MaxHeight="120">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Remove"
                                                    Command="{Binding DataContext.RemoveRevisionFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" FontSize="11" />
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="Add Revision" Command="{Binding AddRevisionCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Add Rendition -->
                <StackPanel Visibility="{Binding IsAddRenditionMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Visibility="{Binding HasLoadedDocument, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="This document type does not allow renditions." Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRenditionable}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel IsEnabled="{Binding IsRenditionable}">
                            <TextBlock Text="New Rendition File(s), added to the latest revision" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="4" Padding="20" Margin="0,0,0,8" AllowDrop="True" x:Name="RenditionFilesDropZone">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Drag and drop file(s) here" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <Button Content="Or Browse..." Command="{Binding AddRenditionFilesCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,8,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ListBox ItemsSource="{Binding RenditionFiles}" Style="{StaticResource FileListStyle}" MaxHeight="120">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Remove"
                                                    Command="{Binding DataContext.RemoveRenditionFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" FontSize="11" />
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="Add Rendition" Command="{Binding AddRenditionCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Delete -->
                <StackPanel Visibility="{Binding IsDeleteMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Visibility="{Binding HasLoadedDocument, Converter={StaticResource BoolToVisibilityConverter}}">
                        <CheckBox Content="Purge (permanently, cannot be recovered from OnBase Document Maintenance)" IsChecked="{Binding PurgeDocument}" Margin="0,0,0,16" />
                        <Button Content="Delete Document" Command="{Binding DeleteCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
