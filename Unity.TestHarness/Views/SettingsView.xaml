<UserControl x:Class="Unity.TestHarness.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="Edits apply in-memory for this run only, unless you Save to App.config."
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,-8,0,20" TextWrapping="Wrap" />

            <!-- Connection -->
            <TextBlock Text="Connection" FontWeight="SemiBold" Margin="0,0,0,8" />

            <TextBlock Text="Application ID" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding ApplicationId, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Service Path" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding ServicePath, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Data Source" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding DataSource, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="License Type" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding LicenseTypes}" SelectedItem="{Binding LicenseType}" />

            <TextBlock Text="Session ID (optional, independent of Authentication Mode below)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding SessionId, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox Content="Keep Alive (session stays connectable after this process exits)" IsChecked="{Binding KeepAlive}" Margin="0,0,0,8" />
            <CheckBox Content="Allow Session Failover (fall back to a new session if reconnecting to Session ID fails)" IsChecked="{Binding AllowSessionFailover}" Margin="0,0,0,20" />

            <!-- Authentication -->
            <TextBlock Text="Authentication" FontWeight="SemiBold" Margin="0,0,0,8" />

            <TextBlock Text="Authentication Mode" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding AuthenticationModes}" SelectedItem="{Binding AuthenticationMode}" />

            <!-- OnBaseCredentials -->
            <StackPanel Visibility="{Binding IsOnBaseCredentialsMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- DomainCredentials -->
            <TextBlock Text="No further settings needed: NT authentication uses the Windows identity this process is already running as."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding IsDomainCredentialsMode, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- AccessToken -->
            <StackPanel Visibility="{Binding IsAccessTokenMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Access Token (leave blank to obtain one automatically via the Hyland IdP settings below)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding AccessToken, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Username (for the IdP &quot;password&quot; grant, if Access Token is blank)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Password (for the IdP &quot;password&quot; grant, if Access Token is blank)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Hyland IdP Settings" FontWeight="SemiBold" Margin="0,8,0,8" />
                <TextBlock Text="IdP URL" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding IdpUrl, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="IdP Tenant" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding IdpTenant, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="IdP Client ID" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding IdpClientId, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="IdP Client Secret" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding IdpClientSecret, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="IdP Scope" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding IdpScope, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="IdP Grant Type (only &quot;password&quot; is currently implemented)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding IdpGrantType, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- SingleSignOn -->
            <StackPanel Visibility="{Binding IsSingleSignOnMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="License Token" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding LicenseToken, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- DocPop -->
            <TextBlock Text="DocPop" FontWeight="SemiBold" Margin="0,12,0,8" />

            <TextBlock Text="DocPop Base URL" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding DocPopBaseUrl, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="DocPop Checksum Seed" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding DocPopChecksumSeed, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,32">
                <Button Content="Apply" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Save to App.config" Command="{Binding SaveToConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Reload" Command="{Binding ReloadCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
