<UserControl x:Class="Unity.TestHarness.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="700">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
        <TextBlock Text="Connect" Style="{StaticResource SectionHeaderStyle}" />

        <!-- Current settings summary -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="16" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Currently Configured (see Settings to change)" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Service Path" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ServicePath}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Data Source" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataSource}" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Authentication Mode" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AuthenticationMode}" Margin="0,4,0,0" />
                </Grid>
                <CheckBox Content="Keep Alive (also editable on Settings)" IsChecked="{Binding KeepAlive}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Server availability -->
        <Border BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsServerAvailable}" Value="True">
                            <Setter Property="Background" Value="#F0FDF4" />
                            <Setter Property="BorderBrush" Value="#BBF7D0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsServerAvailable}" Value="False">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Test API Availability" Command="{Binding TestServerCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="Application Server" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ServerStatusMessage}" TextWrapping="Wrap" />
                    <TextBlock Text="Calls Service.asmx's Ping operation directly, bypassing the Unity API entirely, useful for telling apart &quot;server unreachable&quot; from &quot;server up but something else is wrong&quot;."
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Connection status -->
        <Border BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FEF2F2" />
                    <Setter Property="BorderBrush" Value="#FECACA" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                            <Setter Property="Background" Value="#F0FDF4" />
                            <Setter Property="BorderBrush" Value="#BBF7D0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Margin="0,0,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Not connected" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Text" Value="Connected" />
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding CopySessionIdCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="6" ToolTip="Copy Session ID">
                            <TextBlock Text="&#x1F4CB;" FontSize="13" />
                        </Button>
                        <TextBlock Text="{Binding SessionId, StringFormat='Session ID: {0}'}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding CurrentUserDisplayName, StringFormat='User: {0}'}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
            <Button Content="Connect" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>

        <!-- Reconnect by session ID -->
        <TextBlock Text="Reconnect to Session ID" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="Independent of Settings' own Session ID field; tests Connect(string sessionId) directly."
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,-4,0,8" />
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Paste" Command="{Binding PasteSessionIdCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
            <TextBox Text="{Binding ReconnectSessionIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
        </DockPanel>
        <Button Content="Reconnect" Command="{Binding ReconnectBySessionIdCommand}" Style="{StaticResource SecondaryButtonStyle}"
                HorizontalAlignment="Left" Margin="0,0,0,32" />
    </StackPanel>
    </ScrollViewer>
</UserControl>
