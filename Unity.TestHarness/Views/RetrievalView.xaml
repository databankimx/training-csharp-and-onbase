<UserControl x:Class="Unity.TestHarness.Views.RetrievalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Unity.TestHarness.ViewModels"
             xmlns:views="clr-namespace:Unity.TestHarness.Views"
             xmlns:models="clr-namespace:Unity.TestHarness.Models"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:DocumentDetailViewModel}">
            <views:DocumentDetailView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Search + Results -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,32">
                <DockPanel Margin="0,0,0,16">
                    <TextBlock Text="Retrieval" Style="{StaticResource SectionHeaderStyle}" Margin="0" DockPanel.Dock="Left" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Load Taxonomy" Command="{Binding LoadCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                        <!-- Also reachable here (not just further down, past the keyword
                             fields) so a quick retrieval with no keyword filters doesn't
                             need any scrolling: Load Taxonomy, then Search, immediately. -->
                        <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </DockPanel>

                <!-- Mode selector -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton Content="Document Type(s)" GroupName="SearchMode" Margin="0,0,16,0"
                                 IsChecked="{Binding IsDocumentTypeMode, Mode=OneWay}"
                                 Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:SearchMode.DocumentType}" />
                    <RadioButton Content="Custom Query" GroupName="SearchMode" Margin="0,0,16,0"
                                 IsChecked="{Binding IsCustomQueryMode, Mode=OneWay}"
                                 Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:SearchMode.CustomQuery}" />
                    <RadioButton Content="Document ID" GroupName="SearchMode"
                                 IsChecked="{Binding IsDocumentIdMode, Mode=OneWay}"
                                 Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:SearchMode.DocumentId}" />
                </StackPanel>

                <!-- Document Type mode -->
                <StackPanel Visibility="{Binding IsDocumentTypeMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Filter by Group (optional)" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding DocumentTypeGroupFilters}" SelectedItem="{Binding SelectedGroupFilter}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <!-- The first entry is a null item representing "no filter".
                                     TargetNullValue only substitutes when a PROPERTY PATH
                                     evaluates to null (e.g. Name being null), not when the
                                     bound item itself is null in the first place, WPF can't
                                     evaluate "Name" on a null object at all, so that never
                                     produced a null TargetNullValue could catch. Binding to
                                     the item directly ({Binding}, empty path) and handling
                                     null in the converter sidesteps that entirely. -->
                                <TextBlock Text="{Binding Converter={StaticResource DocumentTypeGroupFilterConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Document Types (select one or more)" Style="{StaticResource FieldLabelStyle}" />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}"
                            Height="180" Margin="0,0,0,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AllDocumentTypesView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Item.Name}" IsChecked="{Binding IsSelected}" Margin="8,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- Custom Query mode -->
                <StackPanel Visibility="{Binding IsCustomQueryMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Custom Query" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding CustomQueries}" SelectedItem="{Binding SelectedCustomQuery}"
                              DisplayMemberPath="Name" Margin="0,0,0,12" />
                </StackPanel>

                <!-- Document ID mode -->
                <StackPanel Visibility="{Binding IsDocumentIdMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Document ID" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding DocumentIdInput, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Get Document" Command="{Binding GetByIdCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,0,0,20" />
                </StackPanel>

                <!-- Shared: keyword fields + date range + Search (Document Type / Custom Query modes only) -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDocumentIdMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Search Keywords" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding SearchKeywordFields}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start Date" Style="{StaticResource FieldLabelStyle}" />
                            <DatePicker SelectedDate="{Binding StartDate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="End Date" Style="{StaticResource FieldLabelStyle}" />
                            <DatePicker SelectedDate="{Binding EndDate}" />
                        </StackPanel>
                    </Grid>

                    <!-- Results -->
                    <TextBlock Text="Results" FontWeight="SemiBold" Margin="0,20,0,8" />
                    <ListBox x:Name="ResultsListBox" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                             Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                             Height="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding Name}" />
                                        <Run Text="(" /><Run Text="{Binding Handle, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding DocDateString}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Document Detail -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="20">
            <ContentControl Content="{Binding Detail}" />
        </Border>
    </Grid>
</UserControl>
