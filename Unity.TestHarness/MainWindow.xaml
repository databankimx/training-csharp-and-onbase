<Window x:Class="Unity.TestHarness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Unity.TestHarness.ViewModels"
        xmlns:views="clr-namespace:Unity.TestHarness.Views"
        Title="DataBank Unity API Test Harness" Height="800" Width="1280"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/AppIcon.png">

    <Window.Resources>
        <!-- *Migration Note: one DataTemplate per page ViewModel type is how WPF picks the
             right View automatically whenever CurrentPage changes, a ContentControl bound
             to CurrentPage renders whichever DataTemplate matches its runtime type, no
             switch statement or if-chain needed anywhere in code. Add one entry here per
             new page as it's built. -->
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar, collapses to icon-only width via IsSidebarExpanded -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="220" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                            <Setter Property="Width" Value="64" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <!-- Branding, with the collapse/expand toggle pinned to the top-right -->
                <Grid DockPanel.Dock="Top" Margin="16,16,12,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" LastChildFill="False">
                        <Image Source="Resources/AppIcon.png" Width="28" Height="28" DockPanel.Dock="Left"
                               VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="DataBank" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Unity API Test Harness" Foreground="#94A3B8" FontSize="10" TextWrapping="Wrap" MaxWidth="140" />
                        </StackPanel>
                    </DockPanel>
                    <Button Grid.Column="1" Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource SidebarButtonStyle}" Padding="6" VerticalAlignment="Top"
                            ToolTip="Collapse/expand sidebar"
                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding IsSidebarExpanded, Converter={StaticResource CollapseGlyphConverter}}" FontSize="18" />
                    </Button>
                </Grid>

                <!-- When collapsed, the toggle moves below the icon (there's no room
                     beside it), still pinned near the top. -->
                <Button DockPanel.Dock="Top" Command="{Binding ToggleSidebarCommand}"
                        Margin="0,0,0,16" HorizontalAlignment="Center"
                        ToolTip="Collapse/expand sidebar">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding IsSidebarExpanded, Converter={StaticResource CollapseGlyphConverter}}" FontSize="18" />
                </Button>

                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    ToolTip="{Binding Name}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="{Binding Glyph}" FontSize="22" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Content + Log -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="220" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="32" Background="{StaticResource BackgroundBrush}">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>

            <!-- Shared output log -->
            <Border Grid.Row="1" Background="{StaticResource SidebarBrush}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
                <DockPanel Margin="16,12,16,12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Output" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                        <Button Content="Clear" Command="{Binding Log.ClearCommand}"
                                DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Log.Entries}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas" FontSize="12">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="0,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#CBD5E1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
