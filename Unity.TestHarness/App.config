<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <section name="onBaseSettings" type="Unity._00.CommonFunctionality.Models.Configuration.OnBaseSettings, Unity.00.CommonFunctionality" />
    </configSections>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <!-- *Migration Note: SidebarExpanded remembers the collapse/expand toggle's state
         across runs, written back here automatically whenever it's toggled (via
         HarnessSettings.cs), not something you need to edit by hand. -->
    <appSettings>
        <add key="SidebarExpanded" value="true" />
    </appSettings>
    <!-- *Migration Note: starting values are placeholders, edit them here directly, or (more
         conveniently) launch the harness and use its Settings page, which can write updated
         values back to this exact section via its "Save to App.config" button. See
         LectureNotes.md. -->
    <onBaseSettings>
        <serviceLocation applicationId="" servicePath="http://OnBaseSandboxVM/AppServer/Service.asmx"
                          dataSource="OnBaseSandbox" licenseType="Default"
                          authenticationMode="OnBaseCredentials" username="MANAGER" password="password" />
        <docPop docPopBaseUrl="http://OnBaseSandboxVM/AppNet/DocPop.aspx" docPopChecksumSeed="" />
        <idpSettings idpUrl="" idpTenant="" idpClientId="" idpClientSecret="" idpScope="evolution" idpGrantType="password" />
    </onBaseSettings>
</configuration>
