<Window x:Class="LessonRunner.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:LessonRunner.Wpf"
        Title="DataBank IMX Developer Training"
        Height="768" Width="1280"
        MinHeight="500" MinWidth="800"
        Icon="Resources/AppIcon.ico"
        Background="{DynamicResource BackgroundBrush}">

    <Window.InputBindings>
        <!-- F5: Run (or re-run) the current step -->
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.RunCommand}" />
        <!-- Escape: cancel a running step, or reset dirty editor to original -->
        <KeyBinding Key="Escape" Command="{x:Static local:MainWindow.EscapeCommand}" />
        <!-- Ctrl+Shift+Enter: Continue past a Pause() -->
        <KeyBinding Key="Enter" Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.ContinueCommand}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.RunCommand}"
                        Executed="RunCommand_Executed"
                        CanExecute="RunCommand_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.EscapeCommand}"
                        Executed="EscapeCommand_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.ContinueCommand}"
                        Executed="ContinueCommand_Executed"
                        CanExecute="ContinueCommand_CanExecute" />
    </Window.CommandBindings>

    <Window.Resources>

        <!-- Tooltip with contrast: dark background, light text -->
        <Style TargetType="ToolTip">
            <Setter Property="Background"   Value="#1A1A1A" />
            <Setter Property="Foreground"   Value="#D4D4D4" />
            <Setter Property="BorderBrush"  Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"      Value="8,4" />
            <Setter Property="FontFamily"   Value="Segoe UI" />
            <Setter Property="FontSize"     Value="12" />
        </Style>

        <!-- TreeViewItem: keep accent highlight whether focused or not -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Padding"         Value="4,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Expand toggle -->
                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Visibility="Hidden"
                                                  Width="16"
                                                  Focusable="False"
                                                  ClickMode="Press">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent" Width="16">
                                                                <TextBlock x:Name="Arrow"
                                                                           Text="&#x25B6;"
                                                                           FontSize="9"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Arrow" Property="Text" Value="&#x25BC;" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <!-- Item content -->
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <!-- Children -->
                            <ItemsPresenter x:Name="ItemsHost"
                                            Margin="16,0,0,0"
                                            Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected"  Value="True" />
                                    <Condition Property="IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <!-- Keep the same accent colour when focus moves elsewhere -->
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeView: transparent background, no border -->
        <Style TargetType="TreeView">
            <Setter Property="Background"      Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground"      Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="14,7" />
            <Setter Property="FontFamily"      Value="Segoe UI" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl with copy button in the strip (no theme toggle here) -->
        <Style x:Key="TabControlWithCopy" TargetType="TabControl">
            <Setter Property="Background"      Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TabPanel Grid.Column="0"
                                              IsItemsHost="True"
                                              Background="Transparent"
                                              HorizontalAlignment="Left" />

                                    <Button Grid.Column="1"
                                            Content="&#x29C9;"
                                            ToolTip="Copy source or lesson markdown to clipboard"
                                            Click="CopyCode_Click"
                                            Background="Transparent"
                                            Foreground="{DynamicResource MutedBrush}"
                                            FontSize="13"
                                            Padding="6,2"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard TabControl (no extras) -->
        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent"
                                          HorizontalAlignment="Left" />
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle button pill style (reusable) -->
        <Style x:Key="PillToggle" TargetType="ToggleButton">
            <Setter Property="Background"      Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Width="40" Height="20">
                            <Ellipse x:Name="Thumb"
                                     Width="14" Height="14"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin"
                                        Value="0,0,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dirty-state dot shown in Source tab header when code has been edited -->
        <Style x:Key="DirtyDot" TargetType="Ellipse">
            <Setter Property="Width"             Value="6" />
            <Setter Property="Height"            Value="6" />
            <Setter Property="Fill"              Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin"            Value="5,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility"        Value="Collapsed" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================ -->
        <!-- LEFT PANEL: Navigation                                           -->
        <!-- ================================================================ -->
        <Grid Grid.Column="0" Background="{DynamicResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="80" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="60" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource AccentBrush}"
                    Padding="10,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- DataBank icon (two-path SVG rendered as Path geometry) -->
                    <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                        <Canvas Width="1000" Height="1000">
                            <Path Fill="White"
                                  Data="M828.67,123.38A497.9,497.9,0,0,0,500,0H0V639.49Z" />
                            <Path Fill="White"
                                  Data="M828.7,123.4.15,1000H500c276.14,0,500-223.86,500-500h0C1000,349.74,933.63,215.06,828.7,123.4Z" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Developer Training"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="CHAPTERS"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="10,10,10,4" />

            <TreeView Grid.Row="2"
                      x:Name="ChapterTree"
                      BorderThickness="0"
                      Background="{DynamicResource PanelBrush}"
                      SelectedItemChanged="ChapterTree_SelectedItemChanged">
                <TreeView.Resources>
                    <!-- Group (chapter with supplementals): expandable header -->
                    <HierarchicalDataTemplate DataType="{x:Type local:ChapterGroup}"
                                              ItemsSource="{Binding Supplementals}">
                        <!-- The header is the main ChapterEntry, selectable directly -->
                        <TextBlock Text="{Binding Main.Name}"
                                   TextWrapping="Wrap"
                                   MouseLeftButtonUp="ChapterHeader_Click"
                                   Cursor="Hand" />
                    </HierarchicalDataTemplate>
                    <!-- Leaf (supplemental or single-project chapter) -->
                    <DataTemplate DataType="{x:Type local:ChapterEntry}">
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>

            <GridSplitter Grid.Row="3"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext" />

            <TextBlock Grid.Row="4"
                       Text="STEPS"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="10,10,10,4" />

            <ListBox Grid.Row="5"
                     x:Name="StepList"
                     BorderThickness="0"
                     SelectionChanged="StepList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ================================================================ -->
        <!-- SPLITTER                                                         -->
        <!-- ================================================================ -->
        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext" />

        <!-- ================================================================ -->
        <!-- RIGHT PANEL                                                      -->
        <!-- ================================================================ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Title bar -->
                <RowDefinition Height="Auto" />  <!-- Args bar -->
                <RowDefinition Height="*" />     <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Title bar: step info | theme toggle | Run -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="StepTitleText"
                                   Text="Select a step from the left panel"
                                   FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="StepSubtitleText"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Theme toggle + Run, right side of title bar -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Dark glyph LEFT of toggle (unchecked = dark) -->
                        <TextBlock Text="&#x1F319;"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />

                        <ToggleButton x:Name="ThemeToggle"
                                      Style="{StaticResource PillToggle}"
                                      Width="40" Height="20"
                                      Checked="ThemeToggle_Checked"
                                      Unchecked="ThemeToggle_Unchecked"
                                      ToolTip="Toggle light / dark theme"
                                      VerticalAlignment="Center" />

                        <!-- Light glyph RIGHT of toggle (checked = light) -->
                        <TextBlock Text="&#x2600;"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="4,0,16,0" />

                        <Button x:Name="RunButton"
                                Content="&#x25B6;  Run"
                                IsEnabled="False"
                                Click="RunButton_Click"
                                ToolTip="Run (F5)"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Args bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="args:"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="Consolas, Courier New"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <TextBox Grid.Column="1"
                             x:Name="ArgsBox"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             CaretBrush="{DynamicResource ForegroundBrush}"
                             FontFamily="Consolas, Courier New"
                             FontSize="12"
                             Padding="6,3"
                             ToolTip="Space-separated command-line arguments passed to Main(string[] args)" />
                </Grid>
            </Border>

            <!-- Output (top) + Code/Lesson tabs (bottom) -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" MinHeight="80" />
                </Grid.RowDefinitions>

                <!-- ========================================================= -->
                <!-- OUTPUT PANE                                                -->
                <!-- ========================================================= -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Output header: label | Continue | copy | clear -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="OUTPUT"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    x:Name="ContinueButton"
                                    Content="&#x25B6;  Continue"
                                    Click="ContinueButton_Click"
                                    ToolTip="Continue (Ctrl+Shift+Enter)"
                                    Visibility="Collapsed"
                                    Margin="0,0,6,0"
                                    Padding="10,3" />

                            <Button Grid.Column="2"
                                    x:Name="VisualizationButton"
                                    Content="&#x1F310;  See Visualization"
                                    Click="VisualizationButton_Click"
                                    Visibility="Collapsed"
                                    Margin="0,0,6,0"
                                    Padding="10,3" />

                            <Button Grid.Column="3"
                                    Content="&#x29C9;"
                                    ToolTip="Copy output to clipboard"
                                    Click="CopyOutput_Click"
                                    Background="Transparent"
                                    Foreground="{DynamicResource MutedBrush}"
                                    FontSize="13"
                                    Padding="6,2"
                                    Margin="0,0,2,0" />

                            <Button Grid.Column="4"
                                    Content="Clear"
                                    Click="ClearOutput_Click"
                                    Background="Transparent"
                                    Foreground="{DynamicResource MutedBrush}"
                                    FontSize="11"
                                    Padding="6,2" />
                        </Grid>
                    </Border>

                    <RichTextBox Grid.Row="1"
                                 x:Name="OutputBox"
                                 IsReadOnly="True"
                                 IsDocumentEnabled="False"
                                 FontFamily="Consolas, Courier New"
                                 FontSize="13"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderThickness="0"
                                 Padding="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 AcceptsReturn="False" />

                    <!-- Output toast: top-right of the output pane -->
                    <Border x:Name="OutputToastBorder"
                            Grid.Row="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,120,0"
                            Background="#DD2D6A2D"
                            CornerRadius="4"
                            Padding="10,5"
                            Opacity="0"
                            IsHitTestVisible="False"
                            Panel.ZIndex="10">
                        <TextBlock x:Name="OutputToastText"
                                   Foreground="White"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Text="Output copied" />
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext" />

                <!-- Source / Lesson tabs with copy button in strip -->
                <Grid Grid.Row="2">
                    <TabControl x:Name="ContentTabs"
                                Style="{StaticResource TabControlWithCopy}">

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Source"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Ellipse x:Name="DirtyIndicator"
                                             Style="{StaticResource DirtyDot}" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Reset bar: visible only when code is edited -->
                                <Border Grid.Row="0"
                                        x:Name="ResetBar"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,4">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                x:Name="ResetButton"
                                                Content="Reset to original"
                                                Click="ResetButton_Click"
                                                ToolTip="Reset (Escape)"
                                                Padding="10,2" />
                                        <TextBlock Text="Code has been edited"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0" />
                                    </DockPanel>
                                </Border>
                                <avalon:TextEditor Grid.Row="1"
                                                   x:Name="SourceEditor"
                                                   ShowLineNumbers="True"
                                                   WordWrap="True"
                                                   FontFamily="Consolas, Courier New"
                                                   FontSize="13"
                                                   Background="{DynamicResource BackgroundBrush}"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Padding="4" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Lesson">
                            <Grid>
                                <!-- Normal lesson view -->
                                <FlowDocumentScrollViewer x:Name="LessonViewer"
                                                          VerticalScrollBarVisibility="Auto"
                                                          IsToolBarVisible="False"
                                                          Background="{DynamicResource BackgroundBrush}" />

                                <!-- Shown when lesson is popped out -->
                                <Border x:Name="LessonPoppedOutPlaceholder"
                                        Background="{DynamicResource BackgroundBrush}"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Lesson is open in a separate window"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,12" />
                                        <Button Content="&#x2B07; Re-dock"
                                                Click="PopOutLesson_Click"
                                                HorizontalAlignment="Center"
                                                Padding="16,7" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                    </TabControl>

                    <!-- Pop-out button: named here so code-behind can update its content.
                         Positioned to sit in the tab strip alongside the copy button. -->
                    <Button x:Name="PopOutButton"
                            Content="&#x2197;"
                            ToolTip="Pop out lesson into a separate window"
                            Click="PopOutLesson_Click"
                            Background="Transparent"
                            Foreground="{DynamicResource MutedBrush}"
                            FontSize="13"
                            Padding="6,2"
                            Margin="0,3,44,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Panel.ZIndex="5" />

                    <!-- Code toast: top-right of the code pane, overlays tab strip -->
                    <Border x:Name="CodeToastBorder"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,4,56,0"
                            Background="#DD2D6A2D"
                            CornerRadius="4"
                            Padding="10,5"
                            Opacity="0"
                            IsHitTestVisible="False"
                            Panel.ZIndex="10">
                        <TextBlock x:Name="CodeToastText"
                                   Foreground="White"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Text="Code copied" />
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
