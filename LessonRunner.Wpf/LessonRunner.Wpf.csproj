<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <RootNamespace>LessonRunner.Wpf</RootNamespace>
    <AssemblyName>LessonRunner.Wpf</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <!-- Overrides the solution-wide net48 default in Directory.Build.props -->
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Highlighting\CSharp-Dark.xshd" />
    <None Remove="Highlighting\CSharp-Light.xshd" />
    <None Remove="Resources\Icon_Blue.svg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Resources\Icon_Blue.svg" />
    <EmbeddedResource Include="Highlighting\CSharp-Dark.xshd" />
    <EmbeddedResource Include="Highlighting\CSharp-Light.xshd" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LessonRunner.Core\LessonRunner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Add via NuGet Package Manager: AvalonEdit for syntax highlighting -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- Markdig needed here because MarkdownRenderer lives in this project -->
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

</Project>
