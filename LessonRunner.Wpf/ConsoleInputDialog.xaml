<Window x:Class="LessonRunner.Wpf.ConsoleInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Console Input"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelBrush}">
    <StackPanel Margin="20,16,20,16">

        <!-- Icon + prompt row -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="IconText"
                       Text="▶"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="18"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <TextBlock x:Name="PromptText"
                       Text="Program output:"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Input field: hidden for pause, shown for ReadLine -->
        <Border x:Name="InputBorder"
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <TextBox x:Name="InputBox"
                     Background="Transparent"
                     Foreground="{DynamicResource ForegroundBrush}"
                     BorderThickness="0"
                     CaretBrush="{DynamicResource ForegroundBrush}"
                     FontFamily="Cascadia Code, Consolas, Courier New"
                     FontSize="13"
                     Padding="8,6"
                     KeyDown="InputBox_KeyDown" />
        </Border>

        <!-- Action button -->
        <Button x:Name="ActionButton"
                Content="Continue"
                Click="Ok_Click"
                HorizontalAlignment="Right"
                MinWidth="100"
                Padding="16,7" />
    </StackPanel>
</Window>
