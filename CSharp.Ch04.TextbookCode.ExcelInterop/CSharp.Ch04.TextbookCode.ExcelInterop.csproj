<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CSharp.Ch04.TextbookCode.ExcelInterop</RootNamespace>
    <AssemblyName>CSharp.Ch04.TextbookCode.ExcelInterop</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <COMReference Include="Microsoft.Office.Interop.Excel">
      <WrapperTool>tlbimp</WrapperTool>
      <VersionMinor>9</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>00020813-0000-0000-c000-000000000046</Guid>
      <Lcid>0</Lcid>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      This project uses a real <COMReference> (WrapperTool=tlbimp), generated by
      Visual Studio's Add > COM Reference dialog against the Excel Object Library
      actually registered on this machine, not the Microsoft.Office.Interop.Excel
      NuGet package used everywhere else. This keeps the original download's
      statically-typed code (Excel.Worksheet, sheet.Cells[1,1].Value, no "dynamic")
      completely untouched.

      IMPORTANT: <COMReference> can only be built by the full .NET Framework MSBuild
      that ships with Visual Studio. The "dotnet" SDK CLI's own MSBuild cannot process
      the ResolveComReference task at all (MSB4803), so "dotnet build"/"dotnet run"
      fail outright regardless of machine setup, this is not a GAC/PIA issue. Build
      this project from Visual Studio (or full MSBuild.exe), never via "dotnet build".
      See LessonRunner\Program.cs (RunLessonWithFullFrameworkMsBuild) for how the
      training launcher handles this.
    -->
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
