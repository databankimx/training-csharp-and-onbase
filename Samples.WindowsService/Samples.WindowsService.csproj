<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Samples.WindowsService</RootNamespace>
    <AssemblyName>Samples.WindowsService</AssemblyName>
  </PropertyGroup>

  <!-- *Migration Note: this is the net48 baseline for the Windows Service pair, added
       alongside Samples.WindowsService.NetCore (see that project's own csproj for the
       rename story). Classic System.ServiceProcess.ServiceBase, not the Generic Host +
       BackgroundService pattern, genuinely different in nearly every respect: the
       OnStart/OnStop event model, System.Timers.Timer instead of PeriodicTimer (which
       doesn't exist on net48), a ServiceInstaller/ServiceProcessInstaller pair for
       InstallUtil.exe-based installation instead of sc create, EF6 Database-First instead
       of EF Core Code-First, and DatabankException instead of LoggerMessage.Define. See
       LectureNotes.md for the full comparison. -->

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Configuration.Install" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF6 (EDMX Database-First), same pattern and same underlying ZipCodes table as
         Samples.MvcWebPortal/Samples.WebForms/Samples.Wpf/Samples.WinForms. -->
    <PackageReference Include="EntityFramework" Version="6.5.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- DatabankException (replacing plain Exception, since CSharp.SharedLibrary is a valid
         reference on net48). -->
    <ProjectReference Include="..\CSharp.SharedLibrary\CSharp.SharedLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="serilog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="README.md" />
    <None Include="LectureNotes.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDK-style auto-globbing only picks up .cs files, these EDMX/T4 items need explicit
         entries so Visual Studio's design-time tooling recognizes them. -->
    <Compile Update="Models\LocationLookupModel.Context.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>LocationLookupModel.Context.tt</DependentUpon>
    </Compile>
    <Compile Update="Models\LocationLookupModel.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>LocationLookupModel.tt</DependentUpon>
    </Compile>
    <Compile Update="Models\LocationLookupModel.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>LocationLookupModel.edmx</DependentUpon>
    </Compile>
    <Compile Update="Models\ZipCode.cs">
      <DependentUpon>LocationLookupModel.tt</DependentUpon>
    </Compile>
    <None Include="Models\LocationLookupModel.Context.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <DependentUpon>LocationLookupModel.edmx</DependentUpon>
      <LastGenOutput>LocationLookupModel.Context.cs</LastGenOutput>
    </None>
    <None Include="Models\LocationLookupModel.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <DependentUpon>LocationLookupModel.edmx</DependentUpon>
      <LastGenOutput>LocationLookupModel.cs</LastGenOutput>
    </None>
    <EntityDeploy Include="Models\LocationLookupModel.edmx">
      <Generator>EntityModelCodeGenerator</Generator>
      <LastGenOutput>LocationLookupModel.Designer.cs</LastGenOutput>
    </EntityDeploy>
    <None Include="Models\LocationLookupModel.edmx.diagram">
      <DependentUpon>LocationLookupModel.edmx</DependentUpon>
    </None>
  </ItemGroup>

</Project>
